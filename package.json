{
  "name": "@temple-wallet/alchemy-sdk",
  "version": "4.0.3",
  "description": "Maintained Alchemy SDK facade. Namespaces and method names from alchemy-sdk, implemented on @alchemy/common and viem.",
  "author": "MadFish.Solutions",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "pre-commit": "lint-staged",
    "prepublishOnly": "yarn build && yarn run lint && yarn run test",
    "prebuild": "node inject-version.cjs",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "format": "prettier --write '**/*.{html,js,json,md,ts}'",
    "format-file": "prettier --write",
    "lint": "eslint -c .eslintrc.cjs '**/*.ts' --ignore-path '.gitignore'",
    "lint-file": "eslint -c .eslintrc.cjs --fix",
    "test": "vitest run",
    "test-integration": "vitest run --config vitest.integration.config.ts",
    "docs": "typedoc --plugin none --out docs src/index.ts",
    "docs-md": "typedoc --plugin typedoc-plugin-markdown --out docs-md src/index.ts",
    "prepare": "husky install"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madfish-solutions/alchemy-sdk-js.git"
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "**/*.ts": [
      "yarn lint-file --fix",
      "yarn format-file"
    ],
    "package.json": [
      "node ./inject-version.cjs",
      "git add src/version.ts"
    ]
  },
  "bugs": {
    "url": "https://github.com/madfish-solutions/alchemy-sdk-js/issues"
  },
  "homepage": "https://github.com/madfish-solutions/alchemy-sdk-js#readme",
  "dependencies": {
    "@alchemy/common": "^5.3.0",
    "viem": "^2.45.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^3.3.1",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^5.16.0",
    "@typescript-eslint/parser": "^5.16.0",
    "dotenv": "^16.0.3",
    "eslint": "^8.11.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^7.0.0",
    "lint-staged": "^12.3.7",
    "mock-socket": "^9.1.4",
    "prettier": "2.6.0",
    "prettier-plugin-jsdoc": "^0.3.38",
    "tslib": "^2.3.1",
    "typedoc": "^0.22.15",
    "typedoc-plugin-markdown": "^3.12.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "sideEffects": false,
  "resolutions": {
    "**/micromatch/picomatch": "2.3.2",
    "@trivago/prettier-plugin-sort-imports/@babel/core/@babel/traverse": "7.17.3",
    "@trivago/prettier-plugin-sort-imports/@babel/traverse": "7.17.3",
    "@babel/traverse": "7.29.12",
    "brace-expansion": "1.1.21",
    "browserslist": "4.29.5",
    "eslint-plugin-import/minimatch": "3.1.5",
    "eslint/minimatch": "3.1.5",
    "flatted": "3.4.4",
    "glob/minimatch": "5.1.9",
    "handlebars": "4.7.10",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "nanoid": "3.3.20",
    "postcss": "8.5.32",
    "source-map-js": "1.2.2",
    "tinypool": "2.2.0",
    "typedoc/minimatch": "5.1.9"
  }
}
